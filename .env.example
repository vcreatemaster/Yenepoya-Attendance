PORT=3001
HOST=127.0.0.1
DB_PATH=./data/attendance.sqlite
# Set to production behind HTTPS; secure cookies are enabled in production.
NODE_ENV=development
# The standalone worker defaults to dry-run. Configure these to enable delivery.
WHATSAPP_MODE=dry-run
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
